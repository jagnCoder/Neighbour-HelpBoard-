# Supabase PostgreSQL connection string.
# Use the URI connection string from Supabase Project Settings > Database > Connection string.
# For serverless deployments, prefer the pooled connection string on port 6543.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Optional Supabase-specific alias. If set, this overrides DATABASE_URL.
SUPABASE_DATABASE_URL=

# Supabase PostgreSQL schema and table used by the backend.
SUPABASE_SCHEMA=public
SUPABASE_POSTS_TABLE=posts

# Connection behavior.
DATABASE_SSL_MODE=require
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10

# Application settings.
TCP_SERVER_IP=0.0.0.0
SERVER_PORT=7000
HTTP_PORT=8000
HTTP_BIND=0.0.0.0
ADMIN_TOKEN=